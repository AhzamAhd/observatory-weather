# Base URL of the GOWC FastAPI backend.
#
# Local dev: run the backend with `cd api && uvicorn main:app --port 8000`
#   NEXT_PUBLIC_API_BASE=http://localhost:8000
#
# Production (Vercel): set this in the Vercel project's Environment Variables
# to your deployed Render backend URL, e.g.
#   NEXT_PUBLIC_API_BASE=https://gowc-api.onrender.com
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Supabase Auth (public values — safe in the browser, protected by RLS).
# From Supabase dashboard → Settings → API. Set the same in Vercel env vars.
# If unset, the app runs fine but hides login (no accounts).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
